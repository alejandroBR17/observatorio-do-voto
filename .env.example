# Desenvolvimento local: SQLite neste computador. Nunca use file: na Vercel.
TURSO_DATABASE_URL=file:.data/observatorio.db
TURSO_AUTH_TOKEN=
# Na Vercel use a URL HTTPS/libsql e o token de um banco Turso remoto.
# TURSO_DATABASE_URL=libsql://SEU-BANCO.turso.io
# TURSO_AUTH_TOKEN=SEU-TOKEN-PRIVADO
# Domínio definitivo com https, sem barra final. Usado em metadados e VAPID.
SITE_URL=http://localhost:3000
# Opcional: contato do administrador para Web Push.
# PUSH_SUBJECT=mailto:seu-email@example.com
# Opcional: segredo longo para um monitor externo. Não configura agenda sozinho.
# CRON_SECRET=
