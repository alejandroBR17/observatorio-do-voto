{
  "name": "observatorio-do-voto",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/verify.mjs && tsx scripts/verify-polls.mjs && tsx --test tests/*.test.ts",
    "db:init": "tsx scripts/init-database.ts",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test:unit": "tsx --test tests/*.test.ts",
    "test:data": "tsx scripts/verify.mjs && tsx scripts/verify-polls.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "3.9.11",
    "lucide-react": "1.52.0",
    "next": "^16.3.8",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/web-push": "^3.6.4",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.5",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.1"
  }
}
